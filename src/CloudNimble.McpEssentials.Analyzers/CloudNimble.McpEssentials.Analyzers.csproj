<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Title>McpEssentials — Analyzers</Title>
        <Description>Catch broken MCP forms at compile time. Warns on unmappable properties, colliding field names, and invalid lambdas. Included with Core; use this package to reference the analyzers on their own.</Description>
        <PackageTags>mcp;modelcontextprotocol;analyzers;roslyn;cloudnimble</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.*" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.*" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssembly</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="PackAnalyzerAssembly">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
