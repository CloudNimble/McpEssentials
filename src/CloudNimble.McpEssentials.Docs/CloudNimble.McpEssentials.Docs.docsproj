<Project Sdk="DotNetDocs.Sdk/1.5.5-preview.1">

    <PropertyGroup>
        <DocumentationType>Mintlify</DocumentationType>
        <GenerateDocumentation>true</GenerateDocumentation>
        <NamespaceMode>Folder</NamespaceMode>
        <ShowDocumentationStats>true</ShowDocumentationStats>

        <ConceptualDocsEnabled>false</ConceptualDocsEnabled>
        <ShowPlaceholders>false</ShowPlaceholders>

        <MintlifyTemplate>
            <Name>McpEssentials</Name>
            <Theme>maple</Theme>
            <Colors>
                <Primary>#419AC5</Primary>
                <Light>#419AC5</Light>
                <Dark>#3CD0E2</Dark>
            </Colors>
            <Navigation Mode="Unified">
                <Pages>
                    <Groups>
                        <Group Name="Getting Started" Icon="stars">
                            <Pages>index</Pages>
                        </Group>
                        <Group Name="Guides" Icon="dog-leashed" Root="guides/index">
                            <Pages>
                                guides/index;
                                guides/authenticated-tasks;
                                guides/form-elicitation;
                                guides/analyzers
                            </Pages>
                            <Groups>
                                <Group Name="Stores" Icon="database" Root="guides/stores/index">
                                    <Pages>
                                        guides/stores/index
                                    </Pages>
                                    <Groups>
                                        <Group Name="Database" Icon="hard-drive">
                                            <Pages>
                                                guides/stores/entity-framework-core;
                                                guides/stores/postgresql;
                                                guides/stores/sql-server;
                                                guides/stores/cosmos;
                                                guides/stores/mongodb;
                                                guides/stores/azure-tables
                                            </Pages>
                                        </Group>
                                        <Group Name="Distributed cache" Icon="server">
                                            <Pages>
                                                guides/stores/redis;
                                                guides/stores/distributed-cache
                                            </Pages>
                                        </Group>
                                        <Group Name="Eventing" Icon="tower-broadcast">
                                            <Pages>
                                                guides/stores/nats
                                            </Pages>
                                        </Group>
                                    </Groups>
                                </Group>
                            </Groups>
                        </Group>
                    </Groups>
                </Pages>
            </Navigation>
        </MintlifyTemplate>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CloudNimble.McpEssentials.Analyzers\CloudNimble.McpEssentials.Analyzers.csproj" />
        <ProjectReference Include="..\CloudNimble.McpEssentials.Core\CloudNimble.McpEssentials.Core.csproj" />
        <ProjectReference Include="..\CloudNimble.McpEssentials.Cosmos\CloudNimble.McpEssentials.Cosmos.csproj" />
        <ProjectReference Include="..\CloudNimble.McpEssentials.EntityFrameworkCore\CloudNimble.McpEssentials.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\CloudNimble.McpEssentials.PostgreSQL\CloudNimble.McpEssentials.PostgreSQL.csproj" />
        <ProjectReference Include="..\CloudNimble.McpEssentials.Redis\CloudNimble.McpEssentials.Redis.csproj" />
    </ItemGroup>

</Project>
