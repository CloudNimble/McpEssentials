<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;</TargetFrameworks>
        <DocumentationFile>$(DocumentationFile)\$(AssemblyName).xml</DocumentationFile>
        <Title>McpEssentials — Core</Title>
        <Description>Authenticated MCP task stores and shared primitives for generic Model Context Protocol servers. Start with InMemoryAuthenticatedMcpTaskStore; swap in a durable provider later.</Description>
        <PackageTags>mcp;modelcontextprotocol;tasks;authentication;cloudnimble</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.*-*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    </ItemGroup>

</Project>
